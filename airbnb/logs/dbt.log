sources:
  - name: raw
    database: airbnb
    tables:
      - name: raw_hosts
        columns:
          - name: id
            data_type: number
          - name: name
            data_type: varchar
          - name: is_superhost
            data_type: varchar
          - name: created_at
            data_type: timestamp_ntz
          - name: updated_at
            data_type: timestamp_ntz

      - name: raw_listings
        columns:
          - name: id
            data_type: number
          - name: listing_url
            data_type: varchar
          - name: name
            data_type: varchar
          - name: room_type
            data_type: varchar
          - name: minimum_nights
            data_type: number
          - name: host_id
            data_type: number
          - name: price
            data_type: varchar
          - name: created_at
            data_type: timestamp_ntz
          - name: updated_at
            data_type: timestamp_ntz

      - name: raw_reviews
        columns:
          - name: listing_id
            data_type: number
          - name: date
            data_type: timestamp_ntz
          - name: reviewer_name
            data_type: varchar
          - name: comments
            data_type: varchar
          - name: sentiment
            data_type: varchar

